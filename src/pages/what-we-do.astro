---
import Base from '../layouts/BaseLayout.astro';
import WhatWeDoGrid from '../components/WhatWeDoGrid.astro';
import StructuredData from '../components/StructuredData.astro';
import RevealOnScroll from '../components/RevealOnScroll.astro';
import { services } from '../data/ssot';
import { siteConfig } from '../data/seo';
---

<Base
	title="What we do — MGG"
	description="Comprehensive event production services including lighting design, sound engineering, staging, and technical solutions for corporate events and live shows. Serving Johannesburg, Cape Town, and South Africa."
	image="/og-what-we-do.jpg"
>
	<StructuredData
		type="BreadcrumbList"
		data={{
			itemListElement: [
				{
					'@type': 'ListItem',
					position: 1,
					name: 'Home',
					item: siteConfig.url,
				},
				{
					'@type': 'ListItem',
					position: 2,
					name: 'What we do',
					item: `${siteConfig.url}/what-we-do`,
				},
			],
		}}
	/>

	<StructuredData
		type="Service"
		data={{
			serviceType: 'Event Production Services',
			provider: {
				'@type': 'Organization',
				name: siteConfig.name,
				url: siteConfig.url,
			},
			description:
				'Professional event production and technical staging services including lighting design, sound design, LED design, video, custom content playback, projection, fabrication design, structure design, technical drafting, and power management.',
			areaServed: {
				'@type': 'Country',
				name: 'South Africa',
			},
			hasOfferCatalog: {
				'@type': 'OfferCatalog',
				name: 'Event Production Services',
				itemListElement: services.map((service, index) => ({
					'@type': 'Offer',
					itemOffered: {
						'@type': 'Service',
						name: service.title,
						description: service.blurb,
					},
					position: index + 1,
				})),
			},
		}}
	/>

	<div class="sr-only">
		<h1>What we do</h1>
	</div>
	<WhatWeDoGrid items={services} />
</Base>

