---
import Base from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import ContactForm from '../components/ContactForm.astro';
import RevealOnScroll from '../components/RevealOnScroll.astro';
import { siteConfig } from '../data/seo';
import { organization } from '../data/ssot';

const jhbBranch = organization.branches.johannesburg;
const cptBranch = organization.branches.capeTown;
---

<Base
	title="Let's connect — MGG"
	description="Get in touch with MGG for your event production needs. Contact our Johannesburg or Cape Town branches. Professional technical staging, lighting design, and sound engineering services across South Africa."
	image="/og-lets-connect.jpg"
>
	<StructuredData
		type="BreadcrumbList"
		data={{
			itemListElement: [
				{
					'@type': 'ListItem',
					position: 1,
					name: 'Home',
					item: siteConfig.url,
				},
				{
					'@type': 'ListItem',
					position: 2,
					name: 'Let\'s connect',
					item: `${siteConfig.url}/lets-connect`,
				},
			],
		}}
	/>

	<StructuredData
		type="ContactPage"
		data={{
			'@type': 'ContactPage',
			name: 'Contact MGG',
			description: 'Contact MGG Productions for event production services in Johannesburg and Cape Town, South Africa',
			mainEntity: [
				{
					'@type': 'LocalBusiness',
					name: `${organization.name} - ${organization.branches.johannesburg.name}`,
					telephone: organization.branches.johannesburg.contact.landline,
					email: organization.branches.johannesburg.contact.email,
					address: {
						'@type': 'PostalAddress',
						streetAddress: organization.branches.johannesburg.location.address.slice(0, -2).join(', '),
						addressLocality: 'Marlboro',
						addressRegion: 'Gauteng',
						postalCode: '2065',
						addressCountry: 'ZA',
					},
				},
				{
					'@type': 'LocalBusiness',
					name: `${organization.name} - ${organization.branches.capeTown.name}`,
					telephone: organization.branches.capeTown.contact.landline,
					email: organization.branches.capeTown.contact.email,
					address: {
						'@type': 'PostalAddress',
						streetAddress: organization.branches.capeTown.location.address.slice(0, -1).join(', '),
						addressLocality: 'Airport City',
						addressRegion: 'Western Cape',
						postalCode: '7490',
						addressCountry: 'ZA',
					},
				},
			],
		}}
	/>

	<section class="bg-white py-12 md:py-16">
		<div class="container">
			<div class="grid lg:grid-cols-2 gap-12">
				<!-- Left Column: Branch Information -->
				<div>
					<RevealOnScroll direction="up" delay={0}>
						<h1 class="text-3xl md:text-2xl font-bold text-black mb-8">Johannesburg</h1>
					</RevealOnScroll>
					
					<!-- Accordion Items -->
					<div class="space-y-4 mb-12">
						<!-- Location Accordion -->
						<RevealOnScroll direction="up" delay={100}>
							<div class="border-b border-gray-200">
							<button
								class="accordion-btn w-full flex items-center justify-between py-4 text-black text-sm font-medium hover:opacity-80 transition"
								aria-expanded="false"
							>
								<span class="font-bold">Location</span>
								<span class="accordion-icon text-xl transition-transform duration-300 ease-in-out">+</span>
							</button>
							<div class="accordion-content overflow-hidden transition-all duration-300 ease-in-out">
								<div class="pb-4 text-black">
									{jhbBranch.location.address.map((line) => (
										<p>{line}</p>
									))}
								</div>
							</div>
						</div>

						<!-- Contact Accordion -->
						<div class="border-b border-gray-200">
							<button
								class="accordion-btn w-full flex items-center justify-between py-4 text-black text-sm font-medium hover:opacity-80 transition"
								aria-expanded="false"
							>
								<span class="font-bold">Contact</span>
								<span class="accordion-icon text-xl transition-transform duration-300 ease-in-out">+</span>
							</button>
							<div class="accordion-content overflow-hidden transition-all duration-300 ease-in-out max-h-0">
								<div class="pb-4 text-black space-y-3">
									{jhbBranch.contact.email && (
										<p>Email: <a href={`mailto:${jhbBranch.contact.email}`} class="underline">{jhbBranch.contact.email}</a></p>
									)}
									{jhbBranch.contact.landline && (
										<p>Phone: <a href={`tel:${jhbBranch.contact.landline.replace(/\s/g, '')}`} class="underline">{jhbBranch.contact.landline}</a></p>
									)}
								</div>
							</div>
							</div>
						</RevealOnScroll>

						<!-- Company Info Accordion -->
						<RevealOnScroll direction="up" delay={300}>
							<div class="border-b border-gray-200">
							<button
								class="accordion-btn w-full flex items-center justify-between py-4 text-black text-sm font-medium hover:opacity-80 transition"
								aria-expanded="false"
							>
								<span class="font-bold">Company Info</span>
								<span class="accordion-icon text-xl transition-transform duration-300 ease-in-out">+</span>
							</button>
							<div class="accordion-content overflow-hidden transition-all duration-300 ease-in-out max-h-0">
								<div class="pb-4 text-black space-y-2">
									{jhbBranch.companyInfo.postalAddress && (
										<p><strong>Postal Address:</strong> {jhbBranch.companyInfo.postalAddress}</p>
									)}
									{jhbBranch.companyInfo.vat && (
										<p><strong>VAT:</strong> {jhbBranch.companyInfo.vat}</p>
									)}
									{jhbBranch.companyInfo.registration && (
										<p><strong>Registration:</strong> {jhbBranch.companyInfo.registration}</p>
									)}
								</div>
							</div>
							</div>
						</RevealOnScroll>
					</div>

					<RevealOnScroll direction="up" delay={400}>
						<h2 class="text-3xl md:text-2xl font-bold text-black mb-8">Cape Town</h2>
					</RevealOnScroll>
					
					<!-- Accordion Items -->
					<div class="space-y-4">
						<!-- Location Accordion -->
						<RevealOnScroll direction="up" delay={500}>
							<div class="border-b border-gray-200">
								<button
									class="accordion-btn w-full flex items-center justify-between py-4 text-black text-sm font-medium hover:opacity-80 transition"
									aria-expanded="false"
								>
									<span class="font-bold">Location</span>
									<span class="accordion-icon text-xl transition-transform duration-300 ease-in-out">+</span>
								</button>
								<div class="accordion-content overflow-hidden transition-all duration-300 ease-in-out max-h-0">
									<div class="pb-4 text-black">
										{cptBranch.location.address.map((line) => (
											<p>{line}</p>
										))}
									</div>
								</div>
							</div>
						</RevealOnScroll>

						<!-- Contact Accordion -->
						<RevealOnScroll direction="up" delay={600}>
							<div class="border-b border-gray-200">
							<button
								class="accordion-btn w-full flex items-center justify-between py-4 text-black text-sm font-medium hover:opacity-80 transition"
								aria-expanded="false"
							>
								<span class="font-bold">Contact</span>
								<span class="accordion-icon text-xl transition-transform duration-300 ease-in-out">+</span>
							</button>
							<div class="accordion-content overflow-hidden transition-all duration-300 ease-in-out max-h-0">
								<div class="pb-4 text-black space-y-3">
									{cptBranch.contact.email && (
										<p>Email: <a href={`mailto:${cptBranch.contact.email}`} class="underline">{cptBranch.contact.email}</a></p>
									)}
									{cptBranch.contact.landline && (
										<p>Phone: <a href={`tel:${cptBranch.contact.landline.replace(/\s/g, '')}`} class="underline">{cptBranch.contact.landline}</a></p>
									)}
								</div>
							</div>
							</div>
						</RevealOnScroll>
					</div>
				</div>

				<!-- Right Column: Contact Form -->
				<RevealOnScroll direction="up" delay={0}>
					<ContactForm />
				</RevealOnScroll>
			</div>
		</div>
	</section>
</Base>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		// Accordion functionality
		const accordionButtons = document.querySelectorAll('.accordion-btn');
		
		accordionButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const content = button.nextElementSibling as HTMLElement;
				const icon = button.querySelector('.accordion-icon') as HTMLElement;
				const isExpanded = button.getAttribute('aria-expanded') === 'true';
				
				if (!content || !icon) return;
				
				// Toggle aria-expanded
				button.setAttribute('aria-expanded', String(!isExpanded));
				
				if (isExpanded) {
					// Close accordion
					icon.style.transform = 'rotate(0deg)';
					content.style.maxHeight = '0px';
					content.classList.remove('open');
				} else {
					// Open accordion
					icon.style.transform = 'rotate(45deg)';
					// Temporarily set to auto to get the actual height
					content.style.maxHeight = 'none';
					const height = content.scrollHeight;
					content.style.maxHeight = '0px';
					// Force reflow
					content.offsetHeight;
					// Now animate to the actual height
					content.style.maxHeight = height + 'px';
					content.classList.add('open');
				}
			});
		});
	});
</script>

<style>
	.accordion-content {
		max-height: 0;
		opacity: 0;
		transition: max-height 0.3s ease-in-out, opacity 0.3s ease-in-out;
	}
	
	.accordion-content.open {
		opacity: 1;
	}
</style>

