---
import Base from '../layouts/BaseLayout.astro';
---

<Base
	title="404 — Page Not Found — MGG"
	description="The page you're looking for doesn't exist. Return to MGG's homepage."
>
	<section class="bg-white flex items-center justify-center py-15">
		<div class="container">
			<div class="max-w-[800px] mx-auto py-10 text-center">
				<!-- 404 Number -->
				<div class="text-center mb-8">
					<h1 class="text-9xl md:text-[12rem] font-bold text-black leading-none mb-4">404</h1>
				</div>
				
				<!-- Error Message with Stripe -->
				<div class="text-center mb-8">
					<h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-black mb-4">
						Page <span class="relative inline-block align-baseline">
							<span class="relative z-10">not found</span>
							<img
								src="/brand/stripe-though.svg"
								alt=""
								class="absolute bottom-0 left-0 w-full h-3 md:h-4 lg:h-5 object-contain"
								aria-hidden="true"
								style="z-index: 0;"
							/>
						</span>
					</h2>
				</div>
				
				<!-- Description -->
				<div class="text-center mb-12 max-w-xl mx-auto">
					<p class="text-lg md:text-xl text-black/70 leading-relaxed">
						Sorry, we couldn't find the page you're looking for. It might have been moved, deleted, or the URL might be incorrect.
					</p>
				</div>
				
				<!-- CTA Buttons -->
				<div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-16 px-4 pb-6">
					<a
						href="/"
						class="w-full sm:w-auto px-8 py-4 border-2 border-black rounded-lg text-black font-semibold hover:bg-black hover:text-white transition-colors duration-200 text-center"
					>
						Go to Homepage
					</a>
					<a
						href="/lets-connect"
						class="w-full sm:w-auto px-8 py-4 border-2 border-black rounded-lg text-black font-semibold hover:bg-black hover:text-white transition-colors duration-200 text-center"
					>
						Get in Touch
					</a>
				</div>
				
				<!-- Quick Links -->
				<div class="pt-16 border-t border-gray-200 pb-6">
					<p class="text-sm font-semibold text-black mb-8 text-center">Quick Links:</p>
					<nav class="flex flex-wrap justify-center gap-3 text-sm font-medium">
						<a href="/" class="px-4 py-2 rounded-full border border-black text-black hover:bg-black hover:text-white transition-colors duration-200">
							Home
						</a>
						<a href="/what-we-do" class="px-4 py-2 rounded-full border border-black text-black hover:bg-black hover:text-white transition-colors duration-200">
							What we do
						</a>
						<a href="/look-book" class="px-4 py-2 rounded-full border border-black text-black hover:bg-black hover:text-white transition-colors duration-200">
							Look Book
						</a>
						<a href="/lets-connect" class="px-4 py-2 rounded-full border border-black text-black hover:bg-black hover:text-white transition-colors duration-200">
							Let's connect
						</a>
					</nav>
				</div>
			</div>
		</div>
	</section>
</Base>

