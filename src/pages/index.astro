---
import Base from '../layouts/BaseLayout.astro';
import HeroSplide from '../components/HeroSplide.astro';
import WhatWeDoIntro from '../components/WhatWeDoIntro.astro';
import WhatWeDoGrid from '../components/WhatWeDoGrid.astro';
import HomeImageGallery from '../components/HomeImageGallery.astro';
import StructuredData from '../components/StructuredData.astro';
import RevealOnScroll from '../components/RevealOnScroll.astro';
import { services } from '../data/ssot';
import { siteConfig } from '../data/seo';
---

<Base
	title={siteConfig.title}
	description={siteConfig.description}
	image="/og-image.jpg"
>
	<!-- Service Schema for all services -->
	<StructuredData
		type="Service"
		data={{
			serviceType: 'Event Production Services',
			provider: {
				'@type': 'Organization',
				name: siteConfig.name,
			},
			areaServed: 'Worldwide',
			hasOfferCatalog: {
				'@type': 'OfferCatalog',
				name: 'Event Production Services',
				itemListElement: services.map((service, index) => ({
					'@type': 'Offer',
					itemOffered: {
						'@type': 'Service',
						name: service.title,
						description: service.blurb,
					},
					position: index + 1,
				})),
			},
		}}
	/>

	<HeroSplide />
	<WhatWeDoIntro />
	<WhatWeDoGrid items={services} slider={true} />
	<section class="bg-white py-16 pb-0">
		<div class="container">
			<RevealOnScroll direction="up" delay={0}>
				<h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-black">
					Take a peek at the magic we create. Have a look at our photo album<a href="/look-book" class="relative inline-block ml-2 align-baseline text-black">
						<img
							src="/brand/stripe-though.svg"
							alt=""
							class="absolute bottom-0 left-0 w-full h-3 md:h-4 lg:h-6 object-contain"
							aria-hidden="true"
							style="z-index: 0;"
						/>
						<span class="relative z-10">here.</span>
					</a>
					
				</h2>
			</RevealOnScroll>
		</div>
	</section>

	<HomeImageGallery />
	
</Base>

