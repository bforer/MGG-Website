---
import Base from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import StructuredData from '../components/StructuredData.astro';
import { siteConfig } from '../data/seo';
import { readdirSync } from 'fs';
import { join } from 'path';

// Get images for structured data from public/lookbook folder
const lookbookDir = join(process.cwd(), 'public', 'lookbook');
const imageExtensions = ['.png', '.jpg', '.jpeg', '.webp', '.gif'];

let images: Array<{ url: string; alt: string }> = [];

try {
	const files = readdirSync(lookbookDir);
	images = files
		.filter((file) => {
			const ext = file.toLowerCase().substring(file.lastIndexOf('.'));
			return imageExtensions.includes(ext);
		})
		.sort()
		.map((file) => ({
			url: new URL(`/lookbook/${file}`, siteConfig.url).toString(),
			alt: file.replace(/\.[^/.]+$/, '') || 'MGG Event Production',
		}));
} catch (error) {
	console.error('Error reading lookbook directory:', error);
}
---

<Base
	title="Look Book — MGG"
	description="Browse our portfolio of event production work including lighting design, sound engineering, and technical staging solutions."
	image="/og-lookbook.jpg"
>
	<StructuredData
		type="ImageGallery"
		data={{
			name: 'MGG Event Production Portfolio',
			description:
				'Gallery of event production work and technical staging solutions',
			image: images.map((img) => ({
				'@type': 'ImageObject',
				contentUrl: img.url,
				description: img.alt,
			})),
		}}
	/>

	<GalleryGrid />
</Base>

