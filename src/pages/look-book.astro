---
import Base from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import StructuredData from '../components/StructuredData.astro';
import { siteConfig } from '../data/seo';
import { readdirSync } from 'fs';
import { join } from 'path';

// Get images for structured data from public/lookbook folder
const lookbookDir = join(process.cwd(), 'public', 'lookbook');
const imageExtensions = ['.png', '.jpg', '.jpeg', '.webp', '.gif'];

let images: Array<{ url: string; alt: string }> = [];

try {
	const files = readdirSync(lookbookDir);
	images = files
		.filter((file) => {
			const ext = file.toLowerCase().substring(file.lastIndexOf('.'));
			return imageExtensions.includes(ext);
		})
		.sort()
		.map((file) => ({
			url: new URL(`/lookbook/${file}`, siteConfig.url).toString(),
			alt: file.replace(/\.[^/.]+$/, '') || 'MGG Event Production',
		}));
} catch (error) {
	console.error('Error reading lookbook directory:', error);
}
---

<Base
	title="Look Book — MGG"
	description="Browse our portfolio of event production work including lighting design, sound engineering, and technical staging solutions. View our gallery of corporate events, live shows, and custom technical experiences."
	image="/og-lookbook.jpg"
>
	<StructuredData
		type="BreadcrumbList"
		data={{
			itemListElement: [
				{
					'@type': 'ListItem',
					position: 1,
					name: 'Home',
					item: siteConfig.url,
				},
				{
					'@type': 'ListItem',
					position: 2,
					name: 'Look Book',
					item: `${siteConfig.url}/look-book`,
				},
			],
		}}
	/>

	<StructuredData
		type="ImageGallery"
		data={{
			name: 'MGG Event Production Portfolio',
			description:
				'Gallery showcasing MGG\'s event production work including professional lighting design, sound engineering, LED displays, video engineering, projection mapping, stage design, and technical staging solutions for corporate events and live shows in South Africa.',
			about: {
				'@type': 'Thing',
				name: 'Event Production Services',
			},
			image: images.slice(0, 20).map((img) => ({
				'@type': 'ImageObject',
				contentUrl: img.url,
				description: img.alt,
				encodingFormat: 'image/webp',
			})),
		}}
	/>

	<GalleryGrid />
</Base>

