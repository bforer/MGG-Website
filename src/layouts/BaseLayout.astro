---
import SEOHead from '../components/SEOHead.astro';
import StructuredData from '../components/StructuredData.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import { siteConfig, type SEOProps } from '../data/seo';
import { organization } from '../data/ssot';
import '../styles/global.css';

interface Props extends SEOProps {
	title?: string;
	description?: string;
}

const {
	title = siteConfig.title,
	description = siteConfig.description,
	...seoProps
} = Astro.props;
---

<html lang="en" class="scroll-smooth">
	<head>
		<!-- Google Tag Manager -->
		<script is:inline>
			(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
			new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
			j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
			'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
			})(window,document,'script','dataLayer','GTM-WM3S92CM');
		</script>
		<!-- End Google Tag Manager -->

		<!-- Adobe Fonts - Helvetica Neue -->
		<link rel="stylesheet" href="https://use.typekit.net/yat3wkl.css">
		
		<SEOHead title={title} description={description} {...seoProps} />

		<!-- Organization Schema -->
		<StructuredData
			type="Organization"
			data={{
				name: organization.name,
				url: organization.url,
				logo: new URL(organization.logo, organization.url).toString(),
				description: siteConfig.description,
				foundingDate: "2015",
				address: {
					'@type': 'PostalAddress',
					addressCountry: 'ZA',
					addressRegion: 'Gauteng',
					addressLocality: 'Johannesburg',
				},
				sameAs: [
					organization.socialMedia.facebook,
					organization.socialMedia.instagram,
					organization.socialMedia.linkedin,
				].filter(Boolean),
				contactPoint: [
					{
						'@type': 'ContactPoint',
						contactType: 'Customer Service',
						areaServed: 'ZA',
						availableLanguage: 'English',
						...(organization.contact.email && { email: organization.contact.email }),
						...(organization.contact.telephone && { telephone: organization.contact.telephone }),
					},
				],
			}}
		/>

		<!-- Website Schema -->
		<StructuredData
			type="WebSite"
			data={{
				name: siteConfig.name,
				url: siteConfig.url,
				description: siteConfig.description,
				inLanguage: 'en-ZA',
				potentialAction: {
					'@type': 'SearchAction',
					target: {
						'@type': 'EntryPoint',
						urlTemplate: `${siteConfig.url}/search?q={search_term_string}`,
					},
					'query-input': 'required name=search_term_string',
				},
			}}
		/>

		<!-- LocalBusiness Schema for Johannesburg Branch -->
		<StructuredData
			type="LocalBusiness"
			data={{
				'@type': 'LocalBusiness',
				name: `${organization.name} - ${organization.branches.johannesburg.name}`,
				image: new URL(organization.logo, organization.url).toString(),
				'@id': `${organization.url}#johannesburg`,
				url: organization.url,
				telephone: organization.branches.johannesburg.contact.landline,
				priceRange: '$$',
				address: {
					'@type': 'PostalAddress',
					streetAddress: organization.branches.johannesburg.location.address.slice(0, -2).join(', '),
					addressLocality: organization.branches.johannesburg.location.address[organization.branches.johannesburg.location.address.length - 2]?.replace(/^[^,]+,\s*/, '') || 'Marlboro',
					addressRegion: 'Gauteng',
					postalCode: organization.branches.johannesburg.location.address[organization.branches.johannesburg.location.address.length - 1]?.match(/\d+/)?.[0] || '2065',
					addressCountry: 'ZA',
				},
				geo: organization.branches.johannesburg.location.gpsCoordinates ? {
					'@type': 'GeoCoordinates',
					latitude: organization.branches.johannesburg.location.gpsCoordinates.latitude,
					longitude: organization.branches.johannesburg.location.gpsCoordinates.longitude,
				} : undefined,
				openingHoursSpecification: {
					'@type': 'OpeningHoursSpecification',
					dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
					opens: '08:00',
					closes: '17:00',
				},
			}}
		/>

		<!-- LocalBusiness Schema for Cape Town Branch -->
		<StructuredData
			type="LocalBusiness"
			data={{
				'@type': 'LocalBusiness',
				name: `${organization.name} - ${organization.branches.capeTown.name}`,
				image: new URL(organization.logo, organization.url).toString(),
				'@id': `${organization.url}#cape-town`,
				url: organization.url,
				telephone: organization.branches.capeTown.contact.landline,
				priceRange: '$$',
				address: {
					'@type': 'PostalAddress',
					streetAddress: organization.branches.capeTown.location.address.slice(0, -1).join(', '),
					addressLocality: 'Airport City',
					addressRegion: 'Western Cape',
					postalCode: organization.branches.capeTown.location.address[organization.branches.capeTown.location.address.length - 1]?.match(/\d+/)?.[0] || '7490',
					addressCountry: 'ZA',
				},
				geo: organization.branches.capeTown.location.gpsCoordinates ? {
					'@type': 'GeoCoordinates',
					latitude: organization.branches.capeTown.location.gpsCoordinates.latitude,
					longitude: organization.branches.capeTown.location.gpsCoordinates.longitude,
				} : undefined,
				openingHoursSpecification: {
					'@type': 'OpeningHoursSpecification',
					dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
					opens: '08:00',
					closes: '17:00',
				},
			}}
		/>
	</head>
	<body class="font-sans antialiased text-[var(--ink)]">
		<!-- Google Tag Manager (noscript) -->
		<noscript>
			<iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WM3S92CM" height="0" width="0" style="display:none;visibility:hidden"></iframe>
		</noscript>
		<!-- End Google Tag Manager (noscript) -->

		<Header />
		<main>
			<slot />
		</main>
		<Footer />
		<ScrollToTop />
	</body>
</html>

