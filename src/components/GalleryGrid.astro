---
import { readdirSync } from 'fs';
import { join } from 'path';

// Read all images from public/lookbook folder
const lookbookDir = join(process.cwd(), 'public', 'lookbook');
const imageExtensions = ['.png', '.jpg', '.jpeg', '.webp', '.gif'];

let images: Array<{ url: string; alt: string }> = [];

try {
	const files = readdirSync(lookbookDir);
	images = files
		.filter((file) => {
			const ext = file.toLowerCase().substring(file.lastIndexOf('.'));
			return imageExtensions.includes(ext);
		})
		.sort()
		.map((file) => ({
			url: `/lookbook/${file}`,
			alt: file.replace(/\.[^/.]+$/, ''), // Remove extension for alt text
		}));
} catch (error) {
	console.error('Error reading lookbook directory:', error);
}

const imagesJson = JSON.stringify(images);
---

<section class="py-12 md:py-16">
	<div class="w-full px-6">
		<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
			{images.map((img, idx) => (
				<button
					class="group relative overflow-hidden rounded-xl aspect-square"
					aria-label={`Open ${img.alt}`}
					data-index={idx}
					onclick={`openModal(${idx})`}
				>
					<img
						src={img.url}
						alt={img.alt}
						loading="lazy"
						class="w-full h-full object-cover transition duration-500 group-hover:scale-105"
					/>
				</button>
			))}
		</div>
	</div>

	<!-- Modal -->
	<div
		id="lb-modal"
		class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-6 group"
	>
		<button
			id="lb-close"
			class="absolute top-4 right-4 rounded-full border border-white/20 bg-black/50 hover:bg-black/70 px-3 py-1 text-sm text-white transition"
		>
			Close
		</button>
		
		<!-- Previous Arrow -->
		<button
			id="lb-prev"
			class="absolute left-4 top-1/2 -translate-y-1/2 rounded-full bg-white hover:opacity-80 p-3 text-black transition z-10"
			aria-label="Previous image"
		>
			<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
			</svg>
		</button>
		
		<!-- Next Arrow -->
		<button
			id="lb-next"
			class="absolute right-4 top-1/2 -translate-y-1/2 rounded-full bg-white hover:opacity-80 p-3 text-black transition z-10"
			aria-label="Next image"
		>
			<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
			</svg>
		</button>
		
		<img
			id="lb-img"
			src=""
			alt=""
			class="max-h-[85vh] max-w-[90vw] rounded-xl shadow-2xl"
		/>
	</div>

	<script is:inline set:html={`
		const modal = document.getElementById('lb-modal');
		const modalImg = document.getElementById('lb-img');
		const modalClose = document.getElementById('lb-close');
		const modalPrev = document.getElementById('lb-prev');
		const modalNext = document.getElementById('lb-next');
		const sources = { images: ${imagesJson} };
		let currentIndex = 0;

		function updateModalImage(index) {
			currentIndex = index;
			modalImg.src = sources.images[index].url;
			modalImg.alt = sources.images[index].alt;
		}

		function openModal(index) {
			currentIndex = index;
			updateModalImage(index);
			modal.classList.remove('hidden');
			modal.classList.add('flex');
			document.body.style.overflow = 'hidden';
		}

		function closeModal() {
			modal.classList.add('hidden');
			modal.classList.remove('flex');
			modalImg.src = '';
			document.body.style.overflow = '';
		}

		function nextImage() {
			currentIndex = (currentIndex + 1) % sources.images.length;
			updateModalImage(currentIndex);
		}

		function prevImage() {
			currentIndex = (currentIndex - 1 + sources.images.length) % sources.images.length;
			updateModalImage(currentIndex);
		}

		modalClose?.addEventListener('click', closeModal);
		modalPrev?.addEventListener('click', (e) => {
			e.stopPropagation();
			prevImage();
		});
		modalNext?.addEventListener('click', (e) => {
			e.stopPropagation();
			nextImage();
		});
		
		modal?.addEventListener('click', (e) => {
			if (e.target === modal) closeModal();
		});

		// Keyboard navigation
		document.addEventListener('keydown', (e) => {
			if (!modal.classList.contains('hidden')) {
				if (e.key === 'ArrowLeft') {
					prevImage();
				} else if (e.key === 'ArrowRight') {
					nextImage();
				} else if (e.key === 'Escape') {
					closeModal();
				}
			}
		});

		window.openModal = openModal;
	`} />
</section>

