---
import type { ServiceItem } from '../data/ssot';
import '@splidejs/splide/dist/css/splide.min.css';

interface Props {
	items: ServiceItem[];
	slider?: boolean; // If true, render as slider; if false, render as grid
}

const { items, slider = false } = Astro.props as Props;

// Helper function to extract hex color from Tailwind bg-[#hex] class
function extractColor(bgColor: string): string {
	const match = bgColor.match(/#[0-9A-Fa-f]{6}/);
	return match ? match[0] : '#000000';
}
---

<section class="bg-[var(--bg)] py-12 md:py-16">
	<div class="mx-auto max-w-7xl px-6">
		<h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-12 md:mb-16">
			Seamless integration of all disciplines.
		</h2>

		{slider ? (
			<!-- Slider Mode -->
			<div class="splide" id="what-we-do-splide">
				<div class="splide__track">
					<ul class="splide__list">
						{items.map((item) => (
							<li class="splide__slide">
								<article class="relative aspect-[1/1] sm:aspect-[4/5] md:aspect-[3/4] overflow-hidden rounded-lg group h-full">
									<!-- Background Image -->
									<img
										src={item.image}
										alt={item.title}
										class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
										loading="lazy"
									/>
									
									<!-- Solid Overlay - expands on hover -->
									<div 
										class="absolute inset-0 transition-all duration-700 ease-out opacity-0 group-hover:opacity-[0.92]"
										style={`background-color: ${extractColor(item.bgColor)};`}
									>
									</div>
									
									<!-- Text Content - Always at bottom -->
									<div class="absolute bottom-0 left-0 right-0 p-6 md:p-7 z-10">
										<h3 class="text-xl md:text-xl lg:text-2xl font-bold text-white mb-2 leading-tight">
											{item.title}
										</h3>
										<div class="max-h-0 group-hover:max-h-96 transition-all duration-700 ease-out overflow-hidden">
											<p class="text-sm md:text-base text-white/95 leading-relaxed pt-2">
												{item.blurb}
											</p>
										</div>
									</div>
								</article>
							</li>
						))}
					</ul>
				</div>
			</div>
		) : (
			<!-- Grid Mode -->
			<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">
				{items.map((item) => (
					<article class="relative aspect-[1/1] sm:aspect-[4/5] md:aspect-[3/4] overflow-hidden rounded-lg group">
						<!-- Background Image -->
						<img
							src={item.image}
							alt={item.title}
							class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
							loading="lazy"
						/>
						
						<!-- Solid Overlay - expands on hover -->
						<div 
							class="absolute inset-0 transition-all duration-700 ease-out opacity-0 group-hover:opacity-[0.92]"
							style={`background-color: ${extractColor(item.bgColor)};`}
						>
						</div>
						
						<!-- Text Content - Always at bottom -->
						<div class="absolute bottom-0 left-0 right-0 p-6 md:p-7 z-10">
							<h3 class="text-xl md:text-xl lg:text-2xl font-bold text-white mb-2 leading-tight">
								{item.title}
							</h3>
							<div class="max-h-0 group-hover:max-h-96 transition-all duration-700 ease-out overflow-hidden">
								<p class="text-sm md:text-base text-white/95 leading-relaxed pt-2">
									{item.blurb}
								</p>
							</div>
						</div>
					</article>
				))}
			</div>
		)}
	</div>
</section>

<style>
	#what-we-do-splide.splide {
		visibility: visible;
	}
	#what-we-do-splide .splide__track {
		overflow: hidden;
	}
	#what-we-do-splide .splide__list {
		display: flex;
		margin: 0 !important;
		padding: 0 !important;
	}
	#what-we-do-splide .splide__slide {
		flex-shrink: 0;
		list-style-type: none !important;
		margin: 0;
		padding: 0;
	}
	#what-we-do-splide .splide__arrow {
		position: absolute !important;
		top: 50% !important;
		transform: translateY(-50%) !important;
		background: white !important;
		width: 3rem !important;
		height: 3rem !important;
		border: none !important;
		z-index: 10 !important;
		border-radius: 50% !important;
		display: flex !important;
		align-items: center !important;
		justify-content: center !important;
		opacity: 0.9 !important;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15) !important;
		transition: opacity 0.2s ease, transform 0.2s ease !important;
	}
	#what-we-do-splide .splide__arrow:hover {
		opacity: 1 !important;
		transform: translateY(-50%) scale(1.05) !important;
	}
	#what-we-do-splide .splide__arrow svg {
		fill: #000 !important;
		width: 1.2rem !important;
		height: 1.2rem !important;
	}
	#what-we-do-splide .splide__arrow--prev {
		left: 1rem !important;
	}
	#what-we-do-splide .splide__arrow--next {
		right: 1rem !important;
	}
	#what-we-do-splide .splide__arrow--prev svg {
		transform: rotate(180deg) !important;
	}
	#what-we-do-splide .splide__arrow--next svg {
		transform: none !important;
	}
	#what-we-do-splide .splide__pagination {
		bottom: -2.5rem;
	}
	#what-we-do-splide .splide__pagination__page {
		background: rgba(255, 255, 255, 0.3);
		width: 0.75rem;
		height: 0.75rem;
	}
	#what-we-do-splide .splide__pagination__page.is-active {
		background: var(--brand-yellow, #FFD700);
	}
</style>

<script>
	import Splide from '@splidejs/splide';
	
	function initWhatWeDoSplide() {
		const splideEl = document.getElementById('what-we-do-splide');
		
		// Only initialize if slider element exists (slider mode is active)
		if (!splideEl || splideEl.classList.contains('splide--initialized')) {
			return;
		}
		
		new Splide(splideEl, {
			type: 'slide',
			perPage: 3,
			perMove: 1,
			gap: '1.25rem',
			padding: { left: 0, right: 0 },
			arrows: true,
			pagination: false,
			speed: 600,
			rewind: false,
			keyboard: 'global',
			breakpoints: {
				1024: {
					perPage: 2,
					gap: '1rem',
				},
				640: {
					perPage: 1,
					gap: '1rem',
				},
			},
		}).mount();
	}
	
	// Wait for DOM to be ready
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', () => {
			setTimeout(initWhatWeDoSplide, 100);
		});
	} else {
		setTimeout(initWhatWeDoSplide, 100);
	}
</script>

