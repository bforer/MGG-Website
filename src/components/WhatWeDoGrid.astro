---
import type { ServiceItem } from '../data/ssot';
// Import core Splide CSS (not the theme) for basic structure
import '@splidejs/splide/dist/css/splide-core.min.css';

interface Props {
	items: ServiceItem[];
	slider?: boolean; // If true, render as slider; if false, render as grid
}

const { items, slider = false } = Astro.props as Props;

// Helper function to extract hex color from Tailwind bg-[#hex] class
function extractColor(bgColor: string): string {
	const match = bgColor.match(/#[0-9A-Fa-f]{6}/);
	return match ? match[0] : '#000000';
}

// Helper function to normalize image paths
function getImageUrl(imagePath: string): string {
	if (imagePath.startsWith('http') || imagePath.startsWith('//')) {
		return imagePath;
	}
	// Ensure path starts with /
	return imagePath.startsWith('/') ? imagePath : `/${imagePath}`;
}
---

<section class="bg-black py-12 md:py-16">
	<div class="container">
		<h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-12 md:mb-16">
			Seamless integration of all disciplines.
		</h2>

		{slider ? (
			<!-- Slider Mode -->
			<div class="splide relative" id="what-we-do-splide">
				<div class="splide__track">
					<ul class="splide__list">
						{items.map((item) => (
							<li class="splide__slide">
								<article class="relative aspect-[1/1] sm:aspect-[4/5] md:aspect-[3/4] overflow-hidden rounded-lg group">
									<!-- Background Image -->
									<img
										src={getImageUrl(item.image)}
										alt={item.title}
										class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
										loading="lazy"
									/>
									
									<!-- Solid Overlay - expands on hover -->
									<div 
										class="absolute inset-0 transition-all duration-700 ease-out opacity-0 group-hover:opacity-[0.92]"
										style={`background-color: ${extractColor(item.bgColor)};`}
									>
									</div>
									
									<!-- Text Content - Always at bottom -->
									<div class="absolute bottom-0 left-0 right-0 p-6 md:p-7 z-10">
										<h3 class="text-xl md:text-xl lg:text-2xl font-bold text-white mb-2 leading-tight">
											{item.title}
										</h3>
										<div class="max-h-0 group-hover:max-h-96 transition-all duration-700 ease-out overflow-hidden">
											<p class="text-sm md:text-base text-white/95 leading-relaxed pt-2">
												{item.blurb}
											</p>
										</div>
									</div>
								</article>
							</li>
						))}
					</ul>
				</div>
			</div>
		) : (
			<!-- Grid Mode -->
			<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">
				{items.map((item) => (
					<article class="relative aspect-[1/1] sm:aspect-[4/5] md:aspect-[3/4] overflow-hidden rounded-lg group">
						<!-- Background Image -->
						<img
							src={item.image}
							alt={item.title}
							class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
							loading="lazy"
						/>
						
						<!-- Solid Overlay - expands on hover -->
						<div 
							class="absolute inset-0 transition-all duration-700 ease-out opacity-0 group-hover:opacity-[0.92]"
							style={`background-color: ${extractColor(item.bgColor)};`}
						>
						</div>
						
						<!-- Text Content - Always at bottom -->
						<div class="absolute bottom-0 left-0 right-0 p-6 md:p-7 z-10">
							<h3 class="text-xl md:text-xl lg:text-2xl font-bold text-white mb-2 leading-tight">
								{item.title}
							</h3>
							<div class="max-h-0 group-hover:max-h-96 transition-all duration-700 ease-out overflow-hidden">
								<p class="text-sm md:text-base text-white/95 leading-relaxed pt-2">
									{item.blurb}
								</p>
							</div>
						</div>
					</article>
				))}
			</div>
		)}
	</div>
</section>

<style is:global>
	/* Essential Splide slider styles */
	#what-we-do-splide.splide {
		visibility: visible;
		position: relative;
	}
	#what-we-do-splide .splide__track {
		overflow: hidden;
		position: relative;
		z-index: 0;
	}
	#what-we-do-splide .splide__list {
		display: flex;
		margin: 0 !important;
		padding: 0 !important;
	}
	#what-we-do-splide .splide__slide {
		flex-shrink: 0;
		list-style-type: none !important;
		margin: 0;
		padding: 0;
	}
	
	/* Hide default Splide pagination */
	#what-we-do-splide .splide__pagination {
		display: none !important;
	}
	
	/* Arrow styles - fully white with chevron style */
	#what-we-do-splide .splide__arrow {
		position: absolute !important;
		top: 50% !important;
		transform: translateY(-50%) !important;
		z-index: 40 !important;
		border: none !important;
		background: white !important;
		border-radius: 9999px !important;
		padding: 0.75rem !important;
		color: black !important;
		width: auto !important;
		height: auto !important;
		cursor: pointer !important;
		transition: opacity 0.2s ease !important;
		display: flex !important;
		align-items: center !important;
		justify-content: center !important;
		opacity: 1 !important;
	}
	#what-we-do-splide .splide__arrow:hover {
		opacity: 0.8 !important;
	}
	#what-we-do-splide .splide__arrow--prev {
		left: 1rem !important;
		right: auto !important;
	}
	#what-we-do-splide .splide__arrow--next {
		right: 1rem !important;
		left: auto !important;
	}
	#what-we-do-splide .splide__arrow svg {
		fill: none !important;
		stroke: currentColor !important;
		stroke-width: 2 !important;
		stroke-linecap: round !important;
		stroke-linejoin: round !important;
		width: 1.5rem !important;
		height: 1.5rem !important;
	}
</style>

<script>
	import Splide from '@splidejs/splide';
	
	let splideInstance: Splide | null = null;
	
	function initWhatWeDoSplide() {
		const splideEl = document.getElementById('what-we-do-splide');
		
		// Only initialize if slider element exists (slider mode is active)
		if (!splideEl || splideEl.classList.contains('splide--initialized')) {
			return;
		}
		
		// Initialize Splide
		splideInstance = new Splide(splideEl, {
			type: 'slide',
			perPage: 3,
			perMove: 1,
			gap: '1.25rem',
			padding: { left: 0, right: 0 },
			arrows: true,
			pagination: false,
			speed: 600,
			rewind: false,
			keyboard: 'global',
			waitForTransition: false,
			breakpoints: {
				1024: {
					perPage: 2,
					gap: '1rem',
				},
				640: {
					perPage: 1,
					gap: '1rem',
				},
			},
		});
		
		splideInstance.mount();
		
		// Replace Splide default SVG arrows with chevron style
		setTimeout(() => {
			const prevArrow = splideEl.querySelector('.splide__arrow--prev');
			const nextArrow = splideEl.querySelector('.splide__arrow--next');
			
			if (prevArrow) {
				const prevSvg = prevArrow.querySelector('svg');
				if (prevSvg) {
					// Clear existing content and rebuild
					prevSvg.innerHTML = '';
					prevSvg.setAttribute('viewBox', '0 0 24 24');
					prevSvg.setAttribute('fill', 'none');
					prevSvg.setAttribute('stroke', 'currentColor');
					const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
					path.setAttribute('d', 'M15 19l-7-7 7-7');
					path.setAttribute('stroke-linecap', 'round');
					path.setAttribute('stroke-linejoin', 'round');
					path.setAttribute('stroke-width', '2');
					prevSvg.appendChild(path);
				}
			}
			
			if (nextArrow) {
				const nextSvg = nextArrow.querySelector('svg');
				if (nextSvg) {
					// Clear existing content and rebuild
					nextSvg.innerHTML = '';
					nextSvg.setAttribute('viewBox', '0 0 24 24');
					nextSvg.setAttribute('fill', 'none');
					nextSvg.setAttribute('stroke', 'currentColor');
					const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
					path.setAttribute('d', 'M9 5l7 7-7 7');
					path.setAttribute('stroke-linecap', 'round');
					path.setAttribute('stroke-linejoin', 'round');
					path.setAttribute('stroke-width', '2');
					nextSvg.appendChild(path);
				}
			}
		}, 50);
	}
	
	// Cleanup function
	function destroySplide() {
		if (splideInstance) {
			splideInstance.destroy();
			splideInstance = null;
		}
	}
	
	// Initialize when DOM is ready
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initWhatWeDoSplide);
	} else {
		initWhatWeDoSplide();
	}
	
	// Cleanup on page unload (for SPA navigation if applicable)
	window.addEventListener('beforeunload', destroySplide);
</script>
