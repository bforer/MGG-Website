			</div>
		</div>
	</div>
</header>

<script is:inline>
	// Make functions globally accessible for onclick handlers
	window.openMobileMenu = function() {
		const overlay = document.getElementById('mobile-menu-overlay');
		const button = document.getElementById('mobile-menu-button');
		if (overlay && button) {
			overlay.classList.remove('translate-x-full');
			button.setAttribute('aria-expanded', 'true');
			document.body.style.overflow = 'hidden';
		}
	};

	window.closeMobileMenu = function() {
		const overlay = document.getElementById('mobile-menu-overlay');
		const button = document.getElementById('mobile-menu-button');
		if (overlay && button) {
			overlay.classList.add('translate-x-full');
			button.setAttribute('aria-expanded', 'false');
			document.body.style.overflow = '';
		}
	};

	// Initialize mobile menu
	document.addEventListener('DOMContentLoaded', function() {
		const menuButton = document.getElementById('mobile-menu-button');
		const menuClose = document.getElementById('mobile-menu-close');
		const overlay = document.getElementById('mobile-menu-overlay');

		if (menuButton) {
			menuButton.addEventListener('click', window.openMobileMenu);
		}

		if (menuClose) {
			menuClose.addEventListener('click', window.closeMobileMenu);
		}

		// Close menu when clicking outside (on overlay background)
		if (overlay) {
			overlay.addEventListener('click', function(e) {
				if (e.target === overlay) {
					window.closeMobileMenu();
				}
			});
		}

		// Close menu on escape key
		document.addEventListener('keydown', function(e) {
			if (e.key === 'Escape' && overlay && !overlay.classList.contains('translate-x-full')) {
				window.closeMobileMenu();
			}
		});

		// Close menu when clicking on links with data-close-menu attribute
		document.querySelectorAll('[data-close-menu]').forEach((link) => {
			link.addEventListener('click', window.closeMobileMenu);
		});
	});
</script>

<style>
	/* Hamburger animation */
	#mobile-menu-button[aria-expanded="true"] span:nth-child(1) {
		transform: rotate(45deg) translate(5px, 5px);
	}
	#mobile-menu-button[aria-expanded="true"] span:nth-child(2) {
		opacity: 0;
	}
	#mobile-menu-button[aria-expanded="true"] span:nth-child(3) {
		transform: rotate(-45deg) translate(7px, -6px);
	}
	
	/* Active nav stripe - brand yellow color using CSS variable */
	.nav-stripe-active {
		background-color: var(--brand-yellow, #ffd700);
		mask-image: url('/brand/stripe-though.svg');
		mask-repeat: no-repeat;
		mask-position: center;
		mask-size: cover;
		-webkit-mask-image: url('/brand/stripe-though.svg');
		-webkit-mask-repeat: no-repeat;
		-webkit-mask-position: center;
		-webkit-mask-size: cover;
		width: 100% !important;
		height: 0.75rem !important; /* h-3 = 0.75rem */
	}
</style>

