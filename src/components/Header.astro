---
// Get current pathname for active navigation state
const currentPath = Astro.url.pathname;
const isActive = (path: string) => {
	if (path === '/') return currentPath === '/';
	return currentPath.startsWith(path);
};

import { organization } from '../data/ssot';
---

<header class="sticky top-0 z-50 bg-white border-b border-gray-200">
	<nav
		class="w-full px-6 py-4 flex items-center justify-between"
		role="navigation"
		aria-label="Main navigation"
	>
		<a href="/" class="flex items-center gap-2" aria-label="MGG Home">
			<img
				src="/brand/mgg-logo.webp"
				alt="MGG Logo"
				class="h-12 w-12 md:h-14 md:w-14 object-contain"
			/>
			<img
				src="/brand/25years.svg"
				alt="25 Years"
				class="h-8 md:h-10 w-auto object-contain"
			/>
		</a>
		
		<!-- Desktop Navigation -->
		<ul class="hidden md:flex items-center gap-6 font-bold">
			<li>
				<a
					class="text-black hover:opacity-80 relative inline-block"
					href="/"
				>
					{isActive('/') && (
						<div
							class="absolute bottom-0 left-0 w-full h-3 nav-stripe-active"
							aria-hidden="true"
							style="z-index: 0;"
						></div>
					)}
					<span class="relative z-10">Home</span>
				</a>
			</li>
			
			<li>
				<a
					class="text-black hover:opacity-80 relative inline-block"
					href="/what-we-do"
				>
					{isActive('/what-we-do') && (
						<div
							class="absolute bottom-0 left-0 w-full h-3 nav-stripe-active"
							aria-hidden="true"
							style="z-index: 0;"
						></div>
					)}
					<span class="relative z-10">What we do</span>
				</a>
			</li>
			<li>
				<a
					class="text-black hover:opacity-80 relative inline-block"
					href="/look-book"
				>
					{isActive('/look-book') && (
						<div
							class="absolute bottom-0 left-0 w-full h-3 nav-stripe-active"
							aria-hidden="true"
							style="z-index: 0;"
						></div>
					)}
					<span class="relative z-10">Look book</span>
				</a>
			</li>
			<li>
				<a
					class="text-black hover:opacity-80 relative inline-block"
					href="/lets-connect"
				>
					{(isActive('/lets-connect') || currentPath.includes('#connect')) && (
						<div
							class="absolute bottom-0 left-0 w-full h-3 nav-stripe-active"
							aria-hidden="true"
							style="z-index: 0;"
						></div>
					)}
					<span class="relative z-10">Let's connect</span>
				</a>
			</li>
		</ul>

		<!-- Mobile Menu Button -->
		<button
			id="mobile-menu-button"
			class="md:hidden flex flex-col gap-1.5 p-2 text-black"
			aria-label="Open menu"
			aria-expanded="false"
		>
			<span class="w-6 h-0.5 bg-black transition-all duration-300"></span>
			<span class="w-6 h-0.5 bg-black transition-all duration-300"></span>
			<span class="w-6 h-0.5 bg-black transition-all duration-300"></span>
		</button>
	</nav>

	<!-- Mobile Menu Overlay -->
	<div
		id="mobile-menu-overlay"
		class="fixed inset-0 bg-white z-[100] transform translate-x-full transition-transform duration-300 ease-in-out overflow-y-auto"
	>
		<div class="min-h-full flex flex-col px-6 py-8">
			<!-- Header with Logo and Close Button -->
			<div class="flex items-center justify-between mb-12">
				<a href="/" class="flex items-center gap-2" aria-label="MGG Home" data-close-menu>
					<img
						src="/brand/mgg-logo.webp"
						alt="MGG Logo"
						class="h-10 w-10 object-contain"
					/>
					<img
						src="/brand/25years.svg"
						alt="25 Years"
						class="h-10 w-auto object-contain"
					/>
				</a>
				<button
					id="mobile-menu-close"
					class="w-10 h-10 rounded-full bg-black/10 flex items-center justify-center text-black hover:bg-black/20 transition"
					aria-label="Close menu"
					data-close-menu
				>
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
					</svg>
				</button>
			</div>

			<!-- Navigation Links -->
			<nav class="flex-1 mb-12">
				<ul class="space-y-6">
					<li>
						<a
							href="/"
							class="text-black text-3xl font-bold hover:opacity-80 transition relative inline-block"
							data-close-menu
						>
							{isActive('/') && (
								<div
									class="absolute bottom-0 left-0 w-full h-3 nav-stripe-active"
									aria-hidden="true"
									style="z-index: 0;"
								></div>
							)}
							<span class="relative z-10">Home</span>
						</a>
					</li>
					<li>
						<a
							href="/what-we-do"
							class="text-black text-3xl font-bold hover:opacity-80 transition relative inline-block"
							data-close-menu
						>
							{isActive('/what-we-do') && (
								<div
									class="absolute bottom-0 left-0 w-full h-3 nav-stripe-active"
									aria-hidden="true"
									style="z-index: 0;"
								></div>
							)}
							<span class="relative z-10">What we do</span>
						</a>
					</li>
					<li>
						<a
							href="/look-book"
							class="text-black text-3xl font-bold hover:opacity-80 transition relative inline-block"
							data-close-menu
						>
							{isActive('/look-book') && (
								<div
									class="absolute bottom-0 left-0 w-full h-3 nav-stripe-active"
									aria-hidden="true"
									style="z-index: 0;"
								></div>
							)}
							<span class="relative z-10">Look book</span>
						</a>
					</li>
					<li>
						<a
							href="/lets-connect"
							class="text-black text-3xl font-bold hover:opacity-80 transition relative inline-block"
							data-close-menu
						>
							{(isActive('/lets-connect') || currentPath.includes('#connect')) && (
								<div
									class="absolute bottom-0 left-0 w-full h-3 nav-stripe-active"
									aria-hidden="true"
									style="z-index: 0;"
								></div>
							)}
							<span class="relative z-10">Let's connect</span>
						</a>
					</li>
				</ul>
			</nav>

			<!-- Contact Information -->
			<div class="mb-12 text-black">
				<p class="font-bold text-lg mb-4">Contact</p>
				<div class="space-y-2 text-sm">
					{organization.contact.email && (
						<p>E: <a href={`mailto:${organization.contact.email}`} class="hover:opacity-80">{organization.contact.email}</a></p>
					)}
					{organization.contact.telephone && (
						<p>T: <a href={`tel:${organization.contact.telephone}`} class="hover:opacity-80">{organization.contact.telephone}</a></p>
					)}
					{!organization.contact.email && !organization.contact.telephone && (
						<>
							<p>E: <a href="mailto:info@mgg.co.za" class="hover:opacity-80">info@mgg.co.za</a></p>
							<p>T: <a href="tel:+27112345678" class="hover:opacity-80">+27 11 234 5678</a></p>
						</>
					)}
				</div>
			</div>

			<!-- Social Media Icons -->
			<div class="flex items-center gap-4">
				{organization.socialMedia.facebook && (
					<a
						href={organization.socialMedia.facebook}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Facebook"
						class="text-black hover:opacity-80 transition"
					>
						<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
							<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
						</svg>
					</a>
				)}
				{organization.socialMedia.instagram && (
					<a
						href={organization.socialMedia.instagram}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Instagram"
						class="text-black hover:opacity-80 transition"
					>
						<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
							<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
						</svg>
					</a>
				)}
				{organization.socialMedia.linkedin && (
					<a
						href={organization.socialMedia.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="LinkedIn"
						class="text-black hover:opacity-80 transition"
					>
						<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
							<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
						</svg>
					</a>
				)}
				{!organization.socialMedia.facebook && !organization.socialMedia.instagram && !organization.socialMedia.linkedin && (
					<>
						<a
							href="#"
							aria-label="Facebook"
							class="text-black hover:opacity-80 transition"
						>
							<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
								<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
							</svg>
						</a>
						<a
							href="#"
							aria-label="Instagram"
							class="text-black hover:opacity-80 transition"
						>
							<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
								<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
							</svg>
