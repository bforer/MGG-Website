---
// Import core Splide CSS (not the theme) for basic structure
import '@splidejs/splide/dist/css/splide-core.min.css';
const slides: { src: string; alt?: string }[] = [
	{ src: '/heroSlider/mgg-main-01.webp', alt: 'MGG event production showcasing professional lighting design and technical staging for corporate events' },
	{ src: '/heroSlider/mgg-main-02.webp', alt: 'MGG technical production featuring LED displays and video walls for immersive event experiences' },
	{ src: '/heroSlider/mgg-main-03.webp', alt: 'MGG stage design and build services creating custom technical staging solutions' },
	{ src: '/heroSlider/mgg-main-05.webp', alt: 'MGG projection mapping and video engineering services transforming event spaces' },
	{ src: '/heroSlider/mgg-main-06.webp', alt: 'MGG custom content playback and multimedia production for memorable event experiences' },
	{ src: '/heroSlider/mgg-main-07.webp', alt: 'MGG structure design and technical staging for large-scale events in South Africa' },
];
---

<div class="relative h-[calc(100vh-80px)] md:h-[calc(100vh-88px)] bg-gray-900" id="hero-slider-container">
	<!-- Fallback first image (visible before Splide initializes) -->
	<img
		src={slides[0].src}
		alt={slides[0].alt}
		class="absolute inset-0 w-full h-full object-cover splide-fallback z-0"
		loading="eager"
	/>
	<div class="splide relative h-full" id="hero-splide" data-total-slides={slides.length}>
		<div class="splide__track h-full">
			<ul class="splide__list h-full">
				{slides.map((s) => (
					<li class="splide__slide relative h-full">
						<img
							src={s.src}
							alt={s.alt}
							class="w-full h-full object-cover"
							loading="eager"
						/>
					</li>
				))}
			</ul>
		</div>
		
		<!-- Progress Bar -->
		<div class="splide__progress">
			<div class="splide__progress__bar"></div>
		</div>
	</div>
	<!-- Static Opacity overlay above banner, below text -->
	<div class="absolute inset-0 bg-black/40 z-20 pointer-events-none"></div>
	<!-- Static Hero Text Overlay -->
	<div class="absolute inset-0 flex items-center justify-center pointer-events-none z-30">
		<div class="container">
			<div class="flex flex-col md:flex-row items-start gap-2 md:gap-3">
				<!-- Column 1: 25 SVG -->
				<div class="flex-shrink-0">
					<img 
						src="/brand/25years.svg" 
						alt="25" 
						class="h-20 md:h-22 lg:h-28 w-auto"
					/>
				</div>
				<!-- Column 2: Text Content -->
				<div class="text-left">
					<h1 class="text-white text-5xl md:text-7xl lg:text-8xl font-bold leading-tight">
						MEMORABLE YEARS.
					</h1>
					<p class="text-white text-lg md:text-xl mt-4 max-w-2xl">
						Collaborating with exceptional clients and doing what we love.
					</p>
				</div>
			</div>
		</div>
	</div>

	<style is:global>
		/* Full screen hero slider container */
		#hero-slider-container {
			width: 100%;
		}
		
		/* Essential Splide slider styles */
		#hero-splide.splide {
			visibility: visible;
			position: relative;
			height: 100%;
			z-index: 0; /* Background layer - lowest */
		}
		#hero-splide .splide__track {
			overflow: hidden;
			position: relative;
			z-index: 0;
			height: 100%;
		}
		#hero-splide .splide__list {
			display: flex;
			height: 100%;
			margin: 0 !important;
			padding: 0 !important;
		}
		#hero-splide .splide__slide {
			flex-shrink: 0;
			list-style-type: none !important;
			margin: 0;
			position: relative;
			height: 100%;
		}
		#hero-splide .splide__slide img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		
		/* Hide default Splide pagination */
		#hero-splide .splide__pagination {
			display: none !important;
		}
		
		/* Progress Bar Styles */
		#hero-splide .splide__progress {
			position: absolute;
			bottom: 0;
			left: 0;
			right: 0;
			height: 3px;
			z-index: 50;
		}
		#hero-splide .splide__progress__bar {
			height: 100%;
			background: var(--brand-yellow, #FFD700);
			width: 0%;
			transition: width 0.1s linear;
		}
		
	/* Arrow container - positioned relative to main container */
	#hero-slider-container .splide__arrows {
		position: absolute !important;
		top: 0 !important;
		left: 0 !important;
		right: 0 !important;
		bottom: 0 !important;
		z-index: 10 !important;
		pointer-events: none !important;
	}
	
	/* Arrow styles - fully white with chevron style - positioned relative to container */
	#hero-slider-container .splide__arrow,
	#hero-slider-container .splide__arrow::before,
	#hero-slider-container .splide__arrow::after {
		background: #ffffff !important;
		background-color: #ffffff !important;
		background-image: none !important;
		box-shadow: none !important;
	}
	#hero-slider-container .splide__arrow {
		position: absolute !important;
		bottom: 1.5rem !important;
		top: auto !important;
		transform: none !important;
		z-index: 10 !important;
		pointer-events: auto !important;
		border: none !important;
		background: #ffffff !important;
		background-color: #ffffff !important;
		background-image: none !important;
		box-shadow: none !important;
		border-radius: 9999px !important;
		padding: 0.75rem !important;
		color: black !important;
		width: auto !important;
		height: auto !important;
		cursor: pointer !important;
		transition: opacity 0.2s ease !important;
		display: flex !important;
		align-items: center !important;
		justify-content: center !important;
		opacity: 1 !important;
	}
	#hero-slider-container .splide__arrow:hover {
		opacity: 0.8 !important;
	}
	#hero-slider-container .splide__arrow--prev {
		right: 5.5rem !important;
		left: auto !important;
	}
	#hero-slider-container .splide__arrow--next {
		right: 1.5rem !important;
		left: auto !important;
	}
	#hero-slider-container .splide__arrow svg {
		fill: none !important;
		stroke: currentColor !important;
		stroke-width: 2 !important;
		stroke-linecap: round !important;
		stroke-linejoin: round !important;
		width: 1.5rem !important;
		height: 1.5rem !important;
	}
	</style>

	<script>
		import Splide from '@splidejs/splide';
		
		let splideInstance: Splide | null = null;
		
		function initSplide() {
			const splideEl = document.getElementById('hero-splide');
			const sliderContainer = document.getElementById('hero-slider-container');
			const fallback = document.querySelector('.splide-fallback') as HTMLElement | null;
			
			if (!splideEl || splideEl.classList.contains('splide--initialized')) {
				return;
			}
			
			// Dynamically calculate header height and set slider height
			const header = document.querySelector('header');
			if (header && sliderContainer) {
				const headerHeight = header.offsetHeight;
				sliderContainer.style.height = `calc(100vh - ${headerHeight}px)`;
			}
			
			// Hide fallback once Splide is ready
			if (fallback) {
				fallback.style.display = 'none';
			}
			
			// Initialize Splide
			splideInstance = new Splide(splideEl, {
				type: 'loop',
				speed: 700,
				autoplay: true,
				interval: 4200,
				pauseOnHover: false,
				arrows: true,
				pagination: false, // Disable default pagination
				rewind: true,
				keyboard: 'global', // Enable keyboard navigation
				waitForTransition: false, // Better performance
				resetProgress: false, // Keep progress when interrupted
			});
			
			splideInstance.mount();
			
			// Move arrows outside splide and replace SVG with chevron style
			setTimeout(() => {
				const arrowsContainer = splideEl.querySelector('.splide__arrows');
				const prevArrow = splideEl.querySelector('.splide__arrow--prev');
				const nextArrow = splideEl.querySelector('.splide__arrow--next');
				
				// Move arrows container to main container (outside splide) so they're above overlay
				if (arrowsContainer && sliderContainer) {
					sliderContainer.appendChild(arrowsContainer);
				}
				
				if (prevArrow) {
					const prevSvg = prevArrow.querySelector('svg');
					if (prevSvg) {
						// Clear existing content and rebuild
						prevSvg.innerHTML = '';
						prevSvg.setAttribute('viewBox', '0 0 24 24');
						prevSvg.setAttribute('fill', 'none');
						prevSvg.setAttribute('stroke', 'currentColor');
						const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
						path.setAttribute('d', 'M15 19l-7-7 7-7');
						path.setAttribute('stroke-linecap', 'round');
						path.setAttribute('stroke-linejoin', 'round');
						path.setAttribute('stroke-width', '2');
						prevSvg.appendChild(path);
					}
				}
				
				if (nextArrow) {
					const nextSvg = nextArrow.querySelector('svg');
					if (nextSvg) {
						// Clear existing content and rebuild
						nextSvg.innerHTML = '';
						nextSvg.setAttribute('viewBox', '0 0 24 24');
						nextSvg.setAttribute('fill', 'none');
						nextSvg.setAttribute('stroke', 'currentColor');
						const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
						path.setAttribute('d', 'M9 5l7 7-7 7');
						path.setAttribute('stroke-linecap', 'round');
						path.setAttribute('stroke-linejoin', 'round');
						path.setAttribute('stroke-width', '2');
						nextSvg.appendChild(path);
					}
				}
			}, 50);
			
			// Update progress bar on autoplay progress
			splideInstance.on('autoplay:playing', (rate: number) => {
				const progressBar = splideEl.querySelector('.splide__progress__bar') as HTMLElement;
				if (progressBar) {
					progressBar.style.width = `${rate * 100}%`;
				}
			});
		}
		
		// Function to update slider height based on header
		function updateSliderHeight() {
			const sliderContainer = document.getElementById('hero-slider-container');
			const header = document.querySelector('header');
			if (header && sliderContainer) {
				const headerHeight = header.offsetHeight;
				sliderContainer.style.height = `calc(100vh - ${headerHeight}px)`;
			}
		}
		
		// Cleanup function
		function destroySplide() {
			if (splideInstance) {
				splideInstance.destroy();
				splideInstance = null;
			}
		}
		
		// Initialize when DOM is ready
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initSplide);
		} else {
			initSplide();
		}
		
		// Update slider height on window resize
		let resizeTimeout: ReturnType<typeof setTimeout>;
		window.addEventListener('resize', () => {
			clearTimeout(resizeTimeout);
			resizeTimeout = setTimeout(updateSliderHeight, 100);
		});
		
		// Cleanup on page unload (for SPA navigation if applicable)
		window.addEventListener('beforeunload', destroySplide);
	</script>
</div>

